{
  "name": "pi-codemode-guard",
  "version": "0.1.1",
  "type": "module",
  "description": "Pi extension that compiles LLM-written codemode scripts into pi's codemode syntax: tolerant argument shapes, markdown fences, @options/@exec pragmas, IIFE wrappers, JSON tool-call programs, missing await, bare tool calls, and the OpenCode / Cloudflare agents / TanStack AI / Vercel AI SDK / DeepSeek Harness PTC / OpenAI Codex code mode dialects",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./compile": "./src/compile.ts",
    "./compile.ts": "./src/compile.ts",
    "./arguments": "./src/arguments.ts",
    "./arguments.ts": "./src/arguments.ts",
    "./contract": "./src/contract.ts",
    "./contract.ts": "./src/contract.ts",
    "./typescript": "./src/passes/typescript.ts",
    "./typescript.ts": "./src/passes/typescript.ts",
    "./dialect": "./src/dialect/detect.ts",
    "./dialect.ts": "./src/dialect/detect.ts",
    "./translate": "./src/dialect/translate.ts",
    "./translate.ts": "./src/dialect/translate.ts",
    "./shims": "./src/core/shims.ts",
    "./shims.ts": "./src/core/shims.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codemode",
    "llm",
    "ai-agent",
    "agentic-coding",
    "tool-calling",
    "compiler",
    "transpiler",
    "await",
    "tool-guard",
    "opencode",
    "cloudflare",
    "tanstack",
    "vercel",
    "deepseek",
    "ptc",
    "codex",
    "openai",
    "ai-sdk",
    "dialect",
    "quickjs",
    "typescript"
  ],
  "author": "Jiajun Chen <tychenjiajun@live.cn>",
  "license": "MIT",
  "homepage": "https://github.com/tychenjiajun/pi-codemode-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tychenjiajun/pi-codemode-guard.git"
  },
  "bugs": {
    "url": "https://github.com/tychenjiajun/pi-codemode-guard/issues"
  },
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/test-support.ts",
    "assets/preview.svg",
    "README.md",
    "README.zh-CN.md",
    "CONTEXT.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "./assets/preview.svg"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.2",
    "@earendil-works/pi-tui": "^0.99.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "sucrase": "^3.35.1"
  },
  "packageManager": "pnpm@12.6.0"
}
