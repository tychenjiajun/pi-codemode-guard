{
  "name": "pi-codemode-guard",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi extension that compiles LLM-written codemode scripts into pi's codemode syntax: tolerant argument shapes, markdown fences, @options lines, IIFE wrappers, JSON tool-call programs, missing await, and the OpenCode / Cloudflare agents / TanStack AI code mode dialects",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./compile": "./compile.ts",
    "./compile.ts": "./compile.ts",
    "./arguments": "./arguments.ts",
    "./arguments.ts": "./arguments.ts",
    "./contract": "./contract.ts",
    "./contract.ts": "./contract.ts",
    "./cloudflare": "./cloudflare.ts",
    "./cloudflare.ts": "./cloudflare.ts",
    "./tanstack": "./tanstack.ts",
    "./tanstack.ts": "./tanstack.ts",
    "./typescript": "./typescript.ts",
    "./typescript.ts": "./typescript.ts",
    "./dialect": "./dialect.ts",
    "./dialect.ts": "./dialect.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codemode",
    "llm",
    "ai-agent",
    "agentic-coding",
    "tool-calling",
    "compiler",
    "transpiler",
    "await",
    "tool-guard",
    "opencode",
    "cloudflare",
    "tanstack",
    "dialect",
    "quickjs",
    "typescript"
  ],
  "author": "Jiajun Chen <tychenjiajun@live.cn>",
  "license": "MIT",
  "homepage": "https://github.com/tychenjiajun/pi-codemode-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tychenjiajun/pi-codemode-guard.git"
  },
  "bugs": {
    "url": "https://github.com/tychenjiajun/pi-codemode-guard/issues"
  },
  "files": [
    "*.ts",
    "!*.test.ts",
    "README.md",
    "README.zh-CN.md",
    "CONTEXT.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.2",
    "@earendil-works/pi-tui": ">=0.99.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.2",
    "@earendil-works/pi-tui": "^0.99.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "sucrase": "^3.35.1"
  },
  "packageManager": "pnpm@12.6.0"
}
